<Window x:Class="DiskVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskVault.App"
        Title="{local:Tr 'DiskVault イメージバックアップ'}" Height="760" Width="1180" MinWidth="960" MinHeight="560"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13" WindowStartupLocation="CenterScreen" Background="#F4F6F9" Icon="pack://application:,,,/app.ico">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="200" Background="#1B2A3F">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,12,22">
                    <TextBlock Text="DiskVault" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{local:Tr 'イメージバックアップ'}" Foreground="#9FB2CC" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="#6F84A3" FontSize="11" Margin="18,10"/>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Nav}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="dash" Content="{local:Tr 'ダッシュボード'}"/>
                    <ListBoxItem Tag="jobs" Content="{local:Tr 'バックアップ ジョブ'}"/>
                    <ListBoxItem Tag="restore" Content="{local:Tr '復元'}"/>
                    <ListBoxItem Tag="pebackup" Content="{local:Tr 'バックアップ'}"/>
                    <ListBoxItem Tag="history" Content="{local:Tr '履歴・ログ'}"/>
                    <ListBoxItem Tag="media" Content="{local:Tr '回復メディア'}"/>
                    <ListBoxItem Tag="settings" Content="{local:Tr '設定'}"/>
                    <ListBoxItem Tag="tools" Content="{local:Tr 'ツール'}"/>
                </ListBox>
            </DockPanel>
        </Border>
        <Border x:Name="AdminBanner" DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E8C66A" BorderThickness="0,0,0,1" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{local:Tr '管理者として再起動'}" Click="RestartAdmin_Click" Margin="0"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{local:Tr '管理者権限なしで動いています。ジョブの保存・実行・復元には管理者権限が必要です。'}"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="PageHost" Margin="24,20,24,16"/>
    </DockPanel>
</Window>


