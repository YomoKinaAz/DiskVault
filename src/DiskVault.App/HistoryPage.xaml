<UserControl x:Class="DiskVault.App.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiskVault.App">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{local:Tr 'ログを開く'}" Click="OpenLog_Click"/>
                <Button Content="{local:Tr '更新'}" Click="Refresh_Click" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{local:Tr '履歴・ログ'}" Style="{StaticResource H1}"/>
        </DockPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="200"/></Grid.RowDefinitions>
            <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="OpenLog_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{local:Tr '開始'}" Binding="{Binding StartText}" Width="140"/>
                    <DataGridTextColumn Header="{local:Tr 'ジョブ'}" Binding="{Binding R.JobName}" Width="130"/>
                    <DataGridTextColumn Header="{local:Tr '種別'}" Binding="{Binding KindText}" Width="50"/>
                    <DataGridTextColumn Header="{local:Tr '契機'}" Binding="{Binding TriggerText}" Width="80"/>
                    <DataGridTemplateColumn Header="{local:Tr '結果'}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding R.StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{local:Tr '所要'}" Binding="{Binding DurationText}" Width="80"/>
                    <DataGridTextColumn Header="{local:Tr '新規'}" Binding="{Binding NewText}" Width="80"/>
                    <DataGridTextColumn Header="{local:Tr '保存'}" Binding="{Binding StoredText}" Width="80"/>
                    <DataGridTextColumn Header="{local:Tr '内容'}" Binding="{Binding Detail}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="LogView" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Consolas, BIZ UDGothic, MS Gothic" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="White"/>
        </Grid>
    </DockPanel>
</UserControl>
