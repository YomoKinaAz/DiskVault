<UserControl x:Class="DiskVault.App.PeBackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="バックアップ（回復環境）" Style="{StaticResource H1}"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,0,0,10"
                   Text="Windows が停止している状態で、ディスク全体をフルバックアップします（スナップショットは使いません）。ここで取ったバックアップは「復元」からベアメタル復元できます。"/>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="再読み込み" Click="Reload_Click" Margin="0"/>
                    <TextBlock Text="バックアップするディスク" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="DiskList" Margin="0,6,0,0" MaxHeight="130" BorderBrush="{StaticResource Border}"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="保存先" Style="{StaticResource Label}"/>
                <TextBox x:Name="DestBox" Grid.Column="1" TextChanged="Dest_Changed" ToolTip="USB ディスクのフォルダ（例 E:\Backup）または NAS（例 \\nas\backup）"/>
                <Button Grid.Column="2" Content="参照…" Click="Browse_Click" Margin="8,0,0,0"/>
                <StackPanel x:Name="CredPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="NAS ユーザー" Style="{StaticResource Label}"/>
                    <TextBox x:Name="UserBox" Width="160"/>
                    <TextBlock Text="パスワード" Style="{StaticResource Label}" Margin="12,0,10,0"/>
                    <PasswordBox x:Name="NasPassBox" Width="150"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="PC 名／名前" Style="{StaticResource Label}" Margin="0,8,10,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="PcBox" Width="170" TextChanged="Dest_Changed"/>
                    <TextBlock Text="\" Style="{StaticResource Label}" Margin="6,0,6,0"/>
                    <TextBox x:Name="NameBox" Width="170" Text="回復環境" TextChanged="Dest_Changed"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="オプション" Style="{StaticResource Label}" Margin="0,8,10,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="圧縮" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="LevelBox" Width="150" SelectedIndex="1">
                        <ComboBoxItem Tag="1">速度優先 (1)</ComboBoxItem>
                        <ComboBoxItem Tag="3">標準 (3)</ComboBoxItem>
                        <ComboBoxItem Tag="9">容量優先 (9)</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="暗号化パスワード" Style="{StaticResource Label}" Margin="16,0,10,0"/>
                    <PasswordBox x:Name="EncBox" Width="130" ToolTip="空欄なら暗号化しません。既存のバックアップ先に追加するときは、そのパスワード"/>
                    <TextBlock Text="確認" Style="{StaticResource Label}" Margin="8,0,10,0"/>
                    <PasswordBox x:Name="Enc2Box" Width="130"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="VerifyBox" Content="終わったら検証する" IsChecked="True" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ExcludeBox" Content="pagefile.sys・hiberfil.sys を除く" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="RepoText" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="2,0,0,8" TextWrapping="Wrap"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StartButton" Content="フルバックアップを開始" Style="{StaticResource Primary}" Click="Start_Click"/>
                <Button x:Name="CancelButton" Content="中止" Click="Cancel_Click" IsEnabled="False" Margin="0"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <ProgressBar x:Name="Bar" Height="10" Maximum="1000"/>
                <TextBlock x:Name="ProgText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas, BIZ UDGothic, MS Gothic" FontSize="12" VerticalScrollBarVisibility="Auto" Background="White" TextWrapping="Wrap"/>
    </DockPanel>
</UserControl>
