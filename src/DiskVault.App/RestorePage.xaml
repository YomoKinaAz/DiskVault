<UserControl x:Class="DiskVault.App.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="復元" Style="{StaticResource H1}"/>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="バックアップ" Style="{StaticResource Label}"/>
                <ComboBox x:Name="SourceBox" Grid.Column="1" SelectionChanged="SourceBox_SelectionChanged"/>
                <Button Grid.Column="2" Content="開く" Style="{StaticResource Primary}" Click="Open_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="PathBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ToolTip="リポジトリのフォルダ（repo.json のあるフォルダ）"/>
                <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Content="参照…" Click="Browse_Click" Margin="8,8,0,0"/>
                <TextBlock x:Name="PathLabel" Grid.Row="1" Text="フォルダ" Style="{StaticResource Label}" Margin="0,8,10,0"/>
                <StackPanel x:Name="CredPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="NAS ユーザー" Style="{StaticResource Label}"/>
                    <TextBox x:Name="UserBox" Width="150"/>
                    <TextBlock Text="パスワード" Style="{StaticResource Label}" Margin="12,0,10,0"/>
                    <PasswordBox x:Name="NasPassBox" Width="130"/>
                    <TextBlock Text="暗号化パスワード" Style="{StaticResource Label}" Margin="12,0,10,0"/>
                    <PasswordBox x:Name="EncPassBox" Width="130"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="RepoInfo" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
            <DataGrid x:Name="Points" SelectionChanged="Points_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日時" Binding="{Binding TimeText}" Width="150"/>
                    <DataGridTextColumn Header="種別" Binding="{Binding KindText}" Width="50"/>
                    <DataGridTextColumn Header="ジョブ" Binding="{Binding Job}" Width="110"/>
                    <DataGridTextColumn Header="ボリューム" Binding="{Binding VolumesText}" Width="*"/>
                    <DataGridTextColumn Header="使用量" Binding="{Binding UsedText}" Width="80"/>
                    <DataGridTextColumn Header="新規" Binding="{Binding NewText}" Width="80"/>
                    <DataGridTextColumn Header="整合性" Binding="{Binding ConsistencyText}" Width="90"/>
                    <DataGridTextColumn Header="ベアメタル" Binding="{Binding BmrText}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,12,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FilesButton" Content="ファイル単位で復元…" Style="{StaticResource Primary}" Click="Files_Click"/>
                    <Button x:Name="VolumeButton" Content="ボリュームを復元…" Click="Volume_Click"/>
                    <Button x:Name="DiskButton" Content="ディスク全体を復元…" Click="Disk_Click"/>
                    <Button x:Name="VerifyButton" Content="検証" Click="Verify_Click" Margin="0"/>
                </StackPanel>
                <TextBlock Text="この復元ポイントのボリューム" Style="{StaticResource H2}" Margin="0"/>
            </DockPanel>
            <DataGrid x:Name="Volumes" Grid.Row="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="30"/>
                    <DataGridTextColumn Header="ボリューム" Binding="{Binding Display}" Width="*"/>
                    <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="90"/>
                    <DataGridTextColumn Header="使用中" Binding="{Binding UsedText}" Width="90"/>
                    <DataGridTextColumn Header="役割" Binding="{Binding Role}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>

