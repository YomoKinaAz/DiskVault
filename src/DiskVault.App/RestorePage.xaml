<UserControl x:Class="DiskVault.App.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiskVault.App">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{local:Tr '復元'}" Style="{StaticResource H1}"/>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="{local:Tr 'バックアップ'}" Style="{StaticResource Label}"/>
                <ComboBox x:Name="SourceBox" Grid.Column="1" SelectionChanged="SourceBox_SelectionChanged"/>
                <Button Grid.Column="2" Content="{local:Tr '開く'}" Style="{StaticResource Primary}" Click="Open_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="PathBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ToolTip="{local:Tr 'リポジトリのフォルダ（repo.json のあるフォルダ）'}"/>
                <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Content="{local:Tr '参照…'}" Click="Browse_Click" Margin="8,8,0,0"/>
                <TextBlock x:Name="PathLabel" Grid.Row="1" Text="{local:Tr 'フォルダ'}" Style="{StaticResource Label}" Margin="0,8,10,0"/>
                <StackPanel x:Name="CredPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{local:Tr 'NAS ユーザー'}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="UserBox" Width="150"/>
                    <TextBlock Text="{local:Tr 'パスワード'}" Style="{StaticResource Label}" Margin="12,0,10,0"/>
                    <PasswordBox x:Name="NasPassBox" Width="130"/>
                    <TextBlock Text="{local:Tr '暗号化パスワード'}" Style="{StaticResource Label}" Margin="12,0,10,0"/>
                    <PasswordBox x:Name="EncPassBox" Width="130"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="RepoInfo" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
            <DataGrid x:Name="Points" SelectionChanged="Points_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{local:Tr '日時'}" Binding="{Binding TimeText}" Width="150"/>
                    <DataGridTextColumn Header="{local:Tr '種別'}" Binding="{Binding KindText}" Width="50"/>
                    <DataGridTextColumn Header="{local:Tr 'ジョブ'}" Binding="{Binding Job}" Width="110"/>
                    <DataGridTextColumn Header="{local:Tr 'ボリューム'}" Binding="{Binding VolumesText}" Width="*"/>
                    <DataGridTextColumn Header="{local:Tr '使用量'}" Binding="{Binding UsedText}" Width="80"/>
                    <DataGridTextColumn Header="{local:Tr '新規'}" Binding="{Binding NewText}" Width="80"/>
                    <DataGridTextColumn Header="{local:Tr '整合性'}" Binding="{Binding ConsistencyText}" Width="90"/>
                    <DataGridTextColumn Header="{local:Tr 'ベアメタル'}" Binding="{Binding BmrText}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,12,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FilesButton" Content="{local:Tr 'ファイル単位で復元…'}" Style="{StaticResource Primary}" Click="Files_Click"/>
                    <Button x:Name="VolumeButton" Content="{local:Tr 'ボリュームを復元…'}" Click="Volume_Click"/>
                    <Button x:Name="DiskButton" Content="{local:Tr 'ディスク全体を復元…'}" Click="Disk_Click"/>
                    <Button x:Name="VerifyButton" Content="{local:Tr '検証'}" Click="Verify_Click" Margin="0"/>
                </StackPanel>
                <TextBlock Text="{local:Tr 'この復元ポイントのボリューム'}" Style="{StaticResource H2}" Margin="0"/>
            </DockPanel>
            <DataGrid x:Name="Volumes" Grid.Row="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="30"/>
                    <DataGridTextColumn Header="{local:Tr 'ボリューム'}" Binding="{Binding Display}" Width="*"/>
                    <DataGridTextColumn Header="{local:Tr 'サイズ'}" Binding="{Binding SizeText}" Width="90"/>
                    <DataGridTextColumn Header="{local:Tr '使用中'}" Binding="{Binding UsedText}" Width="90"/>
                    <DataGridTextColumn Header="{local:Tr '役割'}" Binding="{Binding Role}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>

