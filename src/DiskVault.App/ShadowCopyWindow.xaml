<Window x:Class="DiskVault.App.ShadowCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskVault.App"
        Title="{local:Tr 'シャドウコピーからバックアップ'}" Width="820" Height="520" MinWidth="600" MinHeight="380"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13" WindowStartupLocation="CenterOwner" Background="#F4F6F9" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource H2}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"
                   Text="{local:Tr 'Windows に残っているシャドウコピー（システムの復元ポイントや「以前のバージョン」）の時点の内容で、このジョブを 1 回実行します。更新やウイルスで壊れる前の状態を取っておきたいときに使います。シャドウコピーのないボリューム（EFI など）は今の内容でバックアップします。'}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{local:Tr '種類:'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton x:Name="IncRadio" Content="{local:Tr '増分'}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <RadioButton x:Name="FullRadio" Content="{local:Tr 'フル'}" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <Button x:Name="RunButton" Content="{local:Tr 'バックアップを開始'}" Style="{StaticResource Primary}" Click="Run_Click" IsEnabled="False"/>
            <Button Content="{local:Tr 'キャンセル'}" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                  SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{local:Tr '作成日時'}" Binding="{Binding When}" Width="150"/>
                <DataGridTextColumn Header="{local:Tr 'ボリューム'}" Binding="{Binding Volume}" Width="110"/>
                <DataGridTextColumn Header="{local:Tr '復元ポイント'}" Binding="{Binding RestorePoint}" Width="*"/>
                <DataGridTextColumn Header="{local:Tr 'ID'}" Binding="{Binding Id}" Width="260"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
