<UserControl x:Class="DiskVault.App.JobsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="バックアップ ジョブ" Style="{StaticResource H1}"/>
        <DockPanel DockPanel.Dock="Left" Width="220" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="新規" Click="New_Click"/>
                <Button x:Name="DeleteButton" Content="削除" Click="Delete_Click"/>
            </StackPanel>
            <ListBox x:Name="JobList" DisplayMemberPath="Name" SelectionChanged="JobList_SelectionChanged" BorderBrush="{StaticResource Border}"/>
        </DockPanel>
        <DockPanel x:Name="Editor">
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存" Style="{StaticResource Primary}" Click="Save_Click"/>
                    <Button Content="元に戻す" Click="Revert_Click"/>
                    <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="ジョブ名" Style="{StaticResource Label}"/>
                        <DockPanel Grid.Column="1">
                            <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" Content="有効" Margin="12,0,0,0"/>
                            <TextBox x:Name="NameBox"/>
                        </DockPanel>
                    </Grid>

                    <TextBlock Text="バックアップする範囲" Style="{StaticResource H2}"/>
                    <CheckBox x:Name="SystemBox" Content="システム全体（Windows の入ったディスク：EFI・回復パーティションを含む。ベアメタル復元に必要）" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SystemDetail" Margin="22,0,0,6" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock Text="ほかのドライブ:" Foreground="{StaticResource Muted}" Margin="0,4,0,2"/>
                    <StackPanel x:Name="VolumeBoxes" Margin="8,0,0,0"/>

                    <TextBlock Text="保存先" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="フォルダ" Style="{StaticResource Label}"/>
                        <TextBox x:Name="DestBox" Grid.Column="1" TextChanged="DestBox_TextChanged"/>
                        <Button Grid.Column="2" Content="参照…" Click="Browse_Click" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,6" TextWrapping="Wrap"
                                   Text="例: \\nas\share\Backup（NAS）や E:\Backup（USB ディスク）。この中に「PC 名\ジョブ名」のフォルダを作ります。"/>
                        <StackPanel x:Name="CredPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="ユーザー" Style="{StaticResource Label}"/>
                            <TextBox x:Name="UserBox" Width="180"/>
                            <TextBlock Text="パスワード" Style="{StaticResource Label}" Margin="14,0,10,0"/>
                            <PasswordBox x:Name="PassBox" Width="160"/>
                            <Button Content="接続テスト" Click="TestDest_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="スケジュール" Style="{StaticResource H2}"/>
                    <CheckBox x:Name="SchedBox" Content="スケジュールで自動実行する"/>
                    <Grid x:Name="SchedGrid" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="増分" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <ComboBox x:Name="IncMode" Width="130" SelectionChanged="IncMode_SelectionChanged">
                                <ComboBoxItem Tag="daily">毎日・曜日指定</ComboBoxItem>
                                <ComboBoxItem Tag="hourly">N 時間ごと</ComboBoxItem>
                                <ComboBoxItem Tag="none">しない</ComboBoxItem>
                            </ComboBox>
                            <StackPanel x:Name="DailyPanel" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="時刻" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TimesBox" Width="130" ToolTip="複数あるときはカンマ区切り（例: 02:00, 13:00）"/>
                            </StackPanel>
                            <StackPanel x:Name="HourlyPanel" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBox x:Name="StartBox" Width="60"/>
                                <TextBlock Text="から" Style="{StaticResource Label}" Margin="6,0"/>
                                <TextBox x:Name="IntervalBox" Width="40"/>
                                <TextBlock Text="時間ごと" Style="{StaticResource Label}" Margin="6,0"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel x:Name="DaysPanel" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"/>
                        <TextBlock Grid.Row="2" Text="フル" Style="{StaticResource Label}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <ComboBox x:Name="FullMode" Width="130" SelectionChanged="FullMode_SelectionChanged">
                                <ComboBoxItem Tag="weekly">毎週</ComboBoxItem>
                                <ComboBoxItem Tag="monthly">毎月</ComboBoxItem>
                                <ComboBoxItem Tag="none">最初の 1 回だけ</ComboBoxItem>
                            </ComboBox>
                            <ComboBox x:Name="FullDay" Width="80" Margin="12,0,0,0"/>
                            <StackPanel x:Name="MonthPanel" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBox x:Name="FullDom" Width="40"/>
                                <TextBlock Text="日" Style="{StaticResource Label}" Margin="6,0"/>
                            </StackPanel>
                            <TextBlock Text="時刻" Style="{StaticResource Label}" Margin="12,0,10,0"/>
                            <TextBox x:Name="FullTimeBox" Width="60"/>
                        </StackPanel>
                        <CheckBox x:Name="MissedBox" Grid.Row="3" Grid.Column="1" Content="電源オフなどで実行できなかったときは、次の起動時に実行する"/>
                    </Grid>

                    <TextBlock Text="保持と検証" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="復元ポイントを" Style="{StaticResource Label}"/>
                        <TextBox x:Name="KeepBox" Width="50"/>
                        <TextBlock Text="個残す（古いものから自動削除）" Style="{StaticResource Label}" Margin="8,0"/>
                    </StackPanel>
                    <CheckBox x:Name="VerifyBox" Content="バックアップ後に、作った復元ポイントを読み戻して検証する（時間が延びます）" Margin="0,6,0,0"/>

                    <TextBlock Text="詳細" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="圧縮" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="LevelBox" Width="200">
                            <ComboBoxItem Tag="1">速度優先（レベル 1）</ComboBoxItem>
                            <ComboBoxItem Tag="3">標準（レベル 3）</ComboBoxItem>
                            <ComboBoxItem Tag="9">容量優先（レベル 9）</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ExcludeBox" Content="ページファイル・休止ファイル・古いシャドウコピーを除外する（推奨）"/>
                    <CheckBox x:Name="WritersBox" Content="VSS ライターと連携する（SQL Server などのアプリのデータも整合した状態で保存。推奨）"/>
                    <CheckBox x:Name="VssFullBox" Margin="22,3,12,3" Content="VSS 完全バックアップとして記録する（SQL Server・Exchange のトランザクションログを切り捨てる。ほかのバックアップソフトと併用しない場合だけ）"/>
                    <CheckBox x:Name="EncryptBox" Content="暗号化する（AES-256）" Checked="EncryptBox_Changed" Unchecked="EncryptBox_Changed"/>
                    <StackPanel x:Name="EncPanel" Orientation="Horizontal" Margin="22,2,0,0">
                        <TextBlock Text="パスワード" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="EncPass1" Width="160"/>
                        <TextBlock Text="確認" Style="{StaticResource Label}" Margin="14,0,10,0"/>
                        <PasswordBox x:Name="EncPass2" Width="160"/>
                    </StackPanel>
                    <TextBlock x:Name="EncNote" Margin="22,4,0,0" Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                               Text="このパスワードを忘れると復元できません。回復メディアからの復元でも入力が必要です。"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>

