<Window x:Class="DiskVault.App.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ファイル単位で復元" Height="640" Width="1000" MinWidth="700" MinHeight="400"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13" WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <DockPanel Margin="16">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RestoreButton" Content="チェックしたものを復元…" Style="{StaticResource Primary}" Click="Restore_Click"/>
                <Button Content="閉じる" Click="Close_Click" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="↑" MinWidth="32" Padding="6,3" Click="Up_Click"/>
            <TextBox x:Name="PathBox" IsReadOnly="True" Background="White"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged" BorderBrush="{StaticResource Border}"/>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <DataGrid x:Name="Files" Grid.Column="2" IsReadOnly="False" MouseDoubleClick="Files_MouseDoubleClick" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                    <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="更新日時" Binding="{Binding ModifiedText}" Width="140" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
